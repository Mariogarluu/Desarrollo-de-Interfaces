<Window x:Class="ej1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejercicio 1" Height="200" Width="300"
        x:Name="wnd">
    <Grid>
        <Button Content="Aumentar Texto" 
                FontSize="{Binding ElementName=wnd, Path=TamañoTexto}"
                Click="Button_Click"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10"/>
    </Grid>
</Window>