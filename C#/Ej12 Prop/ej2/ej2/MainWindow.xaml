<Window x:Class="ej2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejercicio 2" Height="200" Width="300"
        x:Name="wnd">
    <StackPanel Margin="20">

        <TextBox Text="Texto de prueba" 
                 Background="{Binding ElementName=wnd, Path=ColorDeFondoTexto}"
                 Height="30"
                 Margin="0,0,0,10"/>
        <Button Content="Cambiar Color" Click="Button_Click"/>
    </StackPanel>
</Window>