<Window x:Class="ej5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="600">
    <Window.Resources>
        <CollectionViewSource x:Key="cvsEstudiantes" Source="{Binding Estudiantes}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Curso"/>
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <DataTemplate x:Key="EstudianteTemplate">
            <Grid Margin="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="50"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Nombre}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{Binding Edad}"/>
                <TextBlock Grid.Column="2" Text="{Binding Nota}"/>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <ListBox x:Name="lstEstudiantes" 
                 ItemsSource="{Binding Source={StaticResource cvsEstudiantes}}"
                 ItemTemplate="{StaticResource EstudianteTemplate}"
                 Grid.Column="0">
            <ListBox.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14" Margin="5,5,0,5"/>
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListBox.GroupStyle>
        </ListBox>

        <StackPanel Grid.Column="1" Margin="20" DataContext="{Binding ElementName=lstEstudiantes, Path=SelectedItem}">
            <TextBlock Text="Detalles del Estudiante:" FontSize="16" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Nombre: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Nombre}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Edad: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Edad}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Nota: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Nota}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,5">
                <TextBlock Text="Curso: " FontWeight="Bold"/>
                <TextBlock Text="{Binding Curso}"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>