<UserControl x:Class="Ejercicio1User_Control.Controls.ColorLabel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ucColorLabel">
    <Border Background="{Binding ColorDeFondo, ElementName=ucColorLabel}" 
            Padding="10" CornerRadius="5" BorderBrush="Black" BorderThickness="1">
        <TextBlock Text="{Binding Texto, ElementName=ucColorLabel}" 
                   FontWeight="Bold" HorizontalAlignment="Center"/>
    </Border>
</UserControl>