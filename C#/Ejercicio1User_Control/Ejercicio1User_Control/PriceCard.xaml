<UserControl x:Class="Ejercicio1User_Control.Controls.PriceCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ucPriceCard">
    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="8" Padding="15" Background="#F0F0F0" Width="150">
        <StackPanel>
            <TextBlock Text="{Binding Precio, ElementName=ucPriceCard}" 
                       FontSize="24" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding Descripcion, ElementName=ucPriceCard}" 
                       FontSize="12" Foreground="Gray" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,5,0,0"/>
        </StackPanel>
    </Border>
</UserControl>