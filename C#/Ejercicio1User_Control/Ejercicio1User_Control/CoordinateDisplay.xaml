<UserControl x:Class="Ejercicio1User_Control.Controls.CoordinateDisplay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ucCoord">
    <Border BorderBrush="#007ACC" BorderThickness="1" CornerRadius="5" Padding="10" Background="#F9F9F9">
        <StackPanel>
            <TextBlock Text="{Binding Titulo, ElementName=ucCoord}" 
                       FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,5"/>

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding CoordenadaX, ElementName=ucCoord, StringFormat='X: {0:F4}'}" Margin="0,0,10,0"/>
                <TextBlock Text="{Binding CoordenadaY, ElementName=ucCoord, StringFormat='Y: {0:F4}'}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>