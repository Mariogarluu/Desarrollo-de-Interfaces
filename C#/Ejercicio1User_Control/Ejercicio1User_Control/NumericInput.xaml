<UserControl x:Class="Ejercicio1User_Control.Controls.NumericInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="ucNumeric">
    <TextBox Text="{Binding Valor, ElementName=ucNumeric, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
             MaxLength="{Binding MaxLength, ElementName=ucNumeric}"
             PreviewTextInput="TextBox_PreviewTextInput"
             Padding="5"/>
</UserControl>