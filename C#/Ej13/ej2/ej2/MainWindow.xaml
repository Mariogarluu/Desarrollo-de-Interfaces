<Window x:Class="ej2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejercicio 2" Height="250" Width="400">
    <StackPanel Margin="20">
        <Label Content="Selecciona una categoría:"/>
        <ComboBox x:Name="cmbCategoria" Margin="0,0,0,20">
            <ComboBoxItem Content="Categoría A"/>
            <ComboBoxItem Content="Categoría B"/>
        </ComboBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Acción 1" Width="80" Margin="5" ToolTip="Realiza la acción primera" Click="Button_Click"/>
            <Button Content="Acción 2" Width="80" Margin="5" ToolTip="Realiza la acción segunda" Click="Button_Click"/>
            <Button Content="Acción 3" Width="80" Margin="5" ToolTip="Realiza la acción tercera" Click="Button_Click"/>
        </StackPanel>
    </StackPanel>
</Window>