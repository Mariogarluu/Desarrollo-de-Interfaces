<Window x:Class="ej2.Ejercicio2"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejercicio 2 - Imágenes" Height="350" Width="400">
    <StackPanel Margin="20">
        <Label Content="¿Cuál es el logo del lenguaje C#?" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <RadioButton x:Name="rbJava" GroupName="Lenguajes" Margin="5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/resources/java.png" Width="30" Height="30" Margin="0,0,10,0"/>
                <TextBlock Text="Java" VerticalAlignment="Center"/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="rbPython" GroupName="Lenguajes" Margin="5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/resources/python.png" Width="30" Height="30" Margin="0,0,10,0"/>
                <TextBlock Text="Python" VerticalAlignment="Center"/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="rbCSharp" GroupName="Lenguajes" Margin="5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/resources/Csharp.png" Width="30" Height="30" Margin="0,0,10,0"/>
                <TextBlock Text="C Sharp" VerticalAlignment="Center"/>
            </StackPanel>
        </RadioButton>

        <RadioButton x:Name="rbJS" GroupName="Lenguajes" Margin="5">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="/resources/js.png" Width="30" Height="30" Margin="0,0,10,0"/>
                <TextBlock Text="JavaScript" VerticalAlignment="Center"/>
            </StackPanel>
        </RadioButton>

        <Button x:Name="btnCorregir" Content="Corregir" Margin="0,20,0,0" Click="BtnCorregir_Click"/>

        <TextBlock x:Name="txtIntentos" Margin="0,10,0,0" Foreground="Red" FontWeight="Bold"/>
    </StackPanel>
</Window>