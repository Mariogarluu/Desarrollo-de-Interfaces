<Window x:Class="ej4.Ejercicio4"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejercicio 4" Height="250" Width="350">
    <StackPanel Margin="15">
        <Label Content="Nivel de seguridad:" FontWeight="Bold"/>
        <RadioButton x:Name="rbBajo" Content="Bajo" IsChecked="True"/>
        <RadioButton x:Name="rbMedio" Content="Medio"/>
        <RadioButton x:Name="rbAlto" Content="Alto"/>

        <Label Content="Contraseña:" Margin="0,10,0,0"/>
        <PasswordBox x:Name="pwdInput" Margin="0,0,0,10"/>

        <Button Content="Verificar" Click="BtnVerificar_Click"/>
    </StackPanel>
</Window>