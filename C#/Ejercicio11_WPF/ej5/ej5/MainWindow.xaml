<Window x:Class="ej5.Ejercicio5"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ejercicio 5 - Pagos" Height="250" Width="350">
    <StackPanel Margin="15">
        <Label Content="Método de pago:" FontWeight="Bold"/>
        <RadioButton x:Name="rbTarjeta" Content="Tarjeta de Crédito" GroupName="Pago"/>
        <RadioButton x:Name="rbPayPal" Content="PayPal" GroupName="Pago"/>
        <RadioButton x:Name="rbTransferencia" Content="Transferencia" GroupName="Pago"/>

        <Label Content="PIN de confirmación:" Margin="0,10,0,0"/>
        <PasswordBox x:Name="pwdPin" Width="100" HorizontalAlignment="Left"/>

        <Button Content="Realizar pago" Margin="0,15,0,0" Click="BtnPagar_Click"/>
    </StackPanel>
</Window>